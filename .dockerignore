# =============================================================================
# .dockerignore — Exclude files not needed in the Docker build context
# =============================================================================
# Keeps the build context small and prevents stale build artifacts from leaking
# into the image.

# Build directories (will be rebuilt inside the image)
build/
build-paraview/

# Git metadata
.git/
.github/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files themselves (not needed inside context beyond Dockerfile)
docker/scripts/

# Documentation build artifacts
doc/_build/
doc/api/

# Benchmark results
benchmark/results/

# Singularity image
*.sif
